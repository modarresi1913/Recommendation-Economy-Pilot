# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Python (for validation / analysis scripts coders may add)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Node (for LLM-coder tooling)
node_modules/

# R
.Rhistory
.RData
.Ruserdata

# Data outputs (keep schemas, ignore raw data by default)
# Schemas are explicitly tracked; data files are gitignored unless force-added.
*.jsonl
!schema/*.json
data/_scratch/
annotations/

# Collection failures (per-wave logs, not published)
collection/failures-*.jsonl

# Logs
*.log
